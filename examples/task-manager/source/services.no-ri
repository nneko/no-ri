import Models from "./models.no-ri"

module Services begin

  pub enum TaskError

    case not_found
    case invalid_title

  end

  pub class TaskService

    prv var tasks: sequence<Models::Task> = []

    def initial() state
    end

    pub def add(
      id: string,
      title: string
    ) -> Models::Task raises TaskError do

      if title.empty?
        raise TaskError.invalid_title
      end

      const task = Models::Task.new(
        id:,
        title:
      )

      tasks.push(task)

      task

    end

    pub def find(
      id: string
    ) -> Models::Task? do

      tasks.find(
        { |task| task.identifier == id } -> boolean
      )

    end

    pub def complete!(
      id: string
    ) raises TaskError do

      const task = find(id)

      if task.nil?
        raise TaskError.not_found
      end

      task.unwrap().complete!

    end

    pub computed count: integer do
      tasks.length
    end

    pub def all -> sequence<Models::Task> do
      tasks.copy()
    end

  end

end
