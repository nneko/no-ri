module Models begin

  pub enum Status

    case pending
    case active
    case completed

    pub computed label: string do

      match self
        case .pending then "Pending"
        case .active then "Active"
        case .completed then "Completed"
      end

    end

  end

  pub protocol Identifiable

    def identifier -> string

  end

  pub struct Position

    pub let x: float
    pub let y: float

    pub computed distance: float do
      (x * x + y * y).sqrt()
    end

  end

  pub class Task < Identifiable

    prv let id: string

    prv var title_value: string
    prv var status_value: Status = .pending

    def initial(
      @id,
      title: string,
      status: Status = .pending
    ) state
      self.title_value = title
      self.status_value = status

    end

    pub def identifier -> string do
      id
    end

    pub computed title: string do

      get do
        title_value
      end

      protected set(value: string) do
        title_value = value
      end

    end

    pub computed status: Status do
      status_value
    end

    pub computed completed?: boolean do
      status_value == .completed
    end

    pub def complete! do
      status_value = .completed
    end

    pub def describe -> string do
      "\(title) [\(status.label)]"
    end

  end

end
