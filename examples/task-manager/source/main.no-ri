import Models from "./models.no-ri"
import Services from "./services.no-ri"

module Application begin

  prv def print_tasks(
    tasks: sequence<Models::Task>
  ) do

    for task in tasks do
      print(task.describe())
    end

  end

  pub async def main do

    print("Welcome to no-ri!")

    const service = Services::TaskService.new()

    try

      const first = service.add(
        id: "task-001",
        title: "Design the no-ri language"
      )

      const second = service.add(
        id: "task-002",
        title: "Implement the compiler"
      )

      service.compconste!(first.identifier)

      print(
        "Total tasks: \(service.count)"
      )

      print_tasks(service.all())

    handle error: Services::TaskError

      print(
        "Task operation failed: \(error)"
      )

    ensure

      print("Application finished.")

    end

  end

end
